# =============================================================================
# CHANAKYA YUVAK MANDAL (CYM) - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in your actual credentials.
# Note: Variables prefixed with `VITE_` are exposed to client-side bundles.
# Never commit your `.env` file containing private credentials to GitHub.
# =============================================================================

# -----------------------------------------------------------------------------
# Google Firebase Configuration
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# -----------------------------------------------------------------------------
# Cloudinary Media Storage (Unsigned Upload Preset)
# Obtain from Cloudinary Dashboard -> Settings -> Upload -> Upload presets
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# -----------------------------------------------------------------------------
# Committee Admin Portal Access & Credentials
# Used by authorized Mandal administrators to manage content, media & timeline
# -----------------------------------------------------------------------------
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PHONE=9999999999
VITE_ADMIN_PASSWORD=ChangeMeInProduction#2026
VITE_ADMIN_PIN=1234
